{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "type-check": "turbo type-check",
    "lint": "turbo lint",
    "test:unit": "turbo test:unit",
    "test:e2e": "turbo test:e2e",
    "format": "prettier --write --experimental-cli apps/*/src packages/*/src"
  },
  "devDependencies": {
    "prettier": "3.9.5",
    "turbo": "^2.6.4"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
